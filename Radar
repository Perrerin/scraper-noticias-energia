import pandas as pd
import random
from datetime import datetime, timedelta
import os

os.makedirs("data", exist_ok=True)

# ===============================
# RADAR
# ===============================

tecnologias = [
    ("Digital Twin", "Digital", "Siemens"),
    ("CBTC NextGen", "Metro", "Alstom"),
    ("Predictive Maintenance AI", "Digital", "Hitachi Rail"),
    ("ATO GoA4", "Metro", "Siemens"),
    ("Smart Ropeway", "Cable", "Doppelmayr"),
    ("Urban Ropeway Analytics", "Cable", "Poma"),
    ("BRT Fleet Optimization", "BRT", "Optibus"),
    ("Autonomous Tram", "Tranvia", "CAF"),
    ("Smart Energy Grid", "Digital", "Schneider"),
    ("IoT Asset Monitoring", "Digital", "Thales"),
    ("Passenger Flow AI", "Metro", "Huawei"),
    ("Battery Tram", "Tranvia", "Stadler"),
    ("Hydrogen Rail", "Metro", "Alstom"),
    ("Smart Ticketing", "Digital", "Cubic"),
    ("Vision Based Inspection", "Digital", "Hitachi Rail")
]

acciones = ["Observar", "Experimentar", "Adoptar", "Escalar"]

datos_radar = []

for tecnologia, categoria, proveedor in tecnologias:

    impacto = random.randint(50, 98)
    madurez = random.randint(40, 98)
    compatibilidad = random.randint(50, 95)
    costo_beneficio = random.randint(50, 95)
    urgencia = random.randint(40, 95)

    score = round(
        impacto * 0.30 +
        madurez * 0.20 +
        compatibilidad * 0.20 +
        costo_beneficio * 0.20 +
        urgencia * 0.10,
        1
    )

    if score >= 85:
        accion = "Escalar"
    elif score >= 70:
        accion = "Adoptar"
    elif score >= 50:
        accion = "Experimentar"
    else:
        accion = "Observar"

    datos_radar.append([
        tecnologia,
        categoria,
        proveedor,
        impacto,
        madurez,
        compatibilidad,
        costo_beneficio,
        urgencia,
        score,
        accion
    ])

radar = pd.DataFrame(
    datos_radar,
    columns=[
        "tecnologia",
        "categoria",
        "proveedor",
        "impacto",
        "madurez",
        "compatibilidad",
        "costo_beneficio",
        "urgencia",
        "score",
        "accion"
    ]
)

radar.to_csv("data/radar.csv", index=False)

